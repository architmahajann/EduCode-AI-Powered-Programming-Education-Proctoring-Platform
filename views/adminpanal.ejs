    <!-- Admin AV Broadcast UI -->
    <div style="position: fixed; bottom: 48px; right: 16px; background: #ffffff; border:1px solid #e9ecef; box-shadow: 0 6px 16px rgba(0,0,0,0.15); padding: 10px; border-radius: 8px; width: 320px; z-index: 1001;">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px;">
            <strong style="color:#0d6efd;">🎥 Camera & Mic Broadcast</strong>
            <small id="avStatus" style="color:#6c757d;">Stopped</small>
        </div>
        <video id="adminPreview" autoplay playsinline muted style="width:100%; height:180px; background:#000; border-radius:6px; display:none;"></video>
        <div style="display:flex; gap:8px; margin-top:8px; justify-content:flex-end;">
            <button id="btnStartAV" class="btn btn-beauty">Start</button>
            <button id="btnStopAV" class="btn btn-danger" disabled>Stop</button>
            <button id="btnToggleMute" class="btn btn-secondary" disabled>Mute</button>
        </div>
    </div>

    <script>
        // Admin AV Broadcast Logic (WebRTC one-to-many)
        (function(){
            const socket = window.socket || io();
            window.socket = socket;
            const roomId = window.location.toString().split('admin/')[1].split('/')[0];
            const preview = document.getElementById('adminPreview');
            const btnStart = document.getElementById('btnStartAV');
            const btnStop = document.getElementById('btnStopAV');
            const btnMute = document.getElementById('btnToggleMute');
            const statusEl = document.getElementById('avStatus');
            let localStream = null;
            // Map of viewer socket id -> RTCPeerConnection
            const pcMap = new Map();
            // ICE servers from server-side env (supports TURN when provided)
            const ICE_SERVERS = (function(){
                try { return JSON.parse('<%- JSON.stringify(WEBRTC_ICE_SERVERS || []) %>'); }
                catch(_) { return [{ urls: ['stun:stun.l.google.com:19302'] }]; }
            })();

            function updateUI(running){
                if (statusEl) statusEl.textContent = running ? 'Live' : 'Stopped';
                if (preview) preview.style.display = running ? 'block' : 'none';
                btnStart && (btnStart.disabled = running);
                btnStop && (btnStop.disabled = !running);
                btnMute && (btnMute.disabled = !running);
            }

            async function startAV(){
                try{
                    localStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
                    preview.srcObject = localStream;
                    updateUI(true);
                    socket.emit('admin-broadcast-av-started', { roomId });
                    tata.success('Broadcast', 'Camera & Mic live');
                } catch(err){
                    console.error('getUserMedia failed', err);
                    tata.error('Broadcast', 'Failed to access camera/mic');
                }
            }

            function stopAV(){
                try{
                    pcMap.forEach((pc) => { try{ pc.close(); } catch(_){} });
                    pcMap.clear();
                    if (localStream){
                        localStream.getTracks().forEach(t => t.stop());
                        localStream = null;
                    }
                    updateUI(false);
                    socket.emit('admin-broadcast-av-stopped', { roomId });
                    tata.warn('Broadcast', 'Stopped');
                } catch(err){ console.error(err); }
            }

            btnStart && btnStart.addEventListener('click', startAV);
            btnStop && btnStop.addEventListener('click', stopAV);
            btnMute && btnMute.addEventListener('click', () => {
                if (!localStream) return;
                const audioTracks = localStream.getAudioTracks();
                if (audioTracks.length){
                    const enable = !audioTracks[0].enabled;
                    audioTracks.forEach(t => t.enabled = enable);
                    btnMute.textContent = enable ? 'Mute' : 'Unmute';
                }
            });

            // When a viewer is ready, create a PC and send an offer
            socket.on('viewer-ready', async ({ viewerSocketId, username }) => {
                try{
                    if (!localStream) return; // ignore if not live
                    if (pcMap.has(viewerSocketId)) return; // already connected
                    const pc = new RTCPeerConnection({ iceServers: ICE_SERVERS });
                    // Add tracks
                    localStream.getTracks().forEach(track => pc.addTrack(track, localStream));
                    // ICE to viewer
                    pc.onicecandidate = (ev) => {
                        if (ev.candidate){
                            socket.emit('webrtc-ice-candidate', { targetSocketId: viewerSocketId, candidate: ev.candidate });
                        }
                    };
                    pc.onconnectionstatechange = () => {
                        if (pc.connectionState === 'failed' || pc.connectionState === 'disconnected' || pc.connectionState === 'closed'){
                            pcMap.delete(viewerSocketId);
                        }
                    };
                    const offer = await pc.createOffer({ offerToReceiveAudio: false, offerToReceiveVideo: false });
                    await pc.setLocalDescription(offer);
                    pcMap.set(viewerSocketId, pc);
                    socket.emit('webrtc-offer', { targetSocketId: viewerSocketId, sdp: pc.localDescription });
                } catch(err){ console.error('viewer-ready handling failed', err); }
            });

            // Receive answers from viewers
            socket.on('webrtc-answer', async ({ from, sdp }) => {
                try{
                    const pc = pcMap.get(from);
                    if (!pc) return;
                    await pc.setRemoteDescription(new RTCSessionDescription(sdp));
                } catch(err){ console.error('setRemoteDescription(answer) failed', err); }
            });

            // ICE from viewers
            socket.on('webrtc-ice-candidate', async ({ from, candidate }) => {
                try{
                    const pc = pcMap.get(from);
                    if (!pc || !candidate) return;
                    await pc.addIceCandidate(new RTCIceCandidate(candidate));
                } catch(err){ console.error('addIceCandidate from viewer failed', err); }
            });

            // Stop AV if server notifies
            socket.on('admin-av-stopped', ({ roomId: r }) => {
                stopAV();
            });
        })();
    </script>
</body>

