                        </div>

                    </div>
                    <div class="editor">
                        <!-- ---Editor here--- -->
                        <textarea id="code" name="code" value=''></textarea>
                    </div>
                    <div class="ide-functions">
                        <div class="io-func">
                            <div class="input">
                                <!-- --inputs-- -->
                                <h4 class="input-title">Input</h4>
